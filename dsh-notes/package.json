{
  "name": "@l77948032-cyber/dsh-notes",
  "version": "0.1.0",
  "description": "Local Markdown notebook for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": ["index.js", "store.js", "client.js", "cordis.patch.yml", "README.md"],
  "scripts": {
    "check": "node --check index.js && node --check store.js && node --check client.js && node --test test.js",
    "test": "node --test test.js"
  },
  "dsh": {
    "engines": { "dsh": ">=0.2.0-rc.2 <0.3.0" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-primitives"],
      "platform": "web"
    },
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "sanitize-html": "^2.17.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2 <0.3.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "engines": { "node": ">=22.19.0" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l77948032-cyber/DSH-Plugins.git",
    "directory": "dsh-notes"
  },
  "license": "MIT"
}
